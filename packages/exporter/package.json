    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@optic/eslint-config": "workspace:*",
    "@optic/typescript-config": "workspace:*",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
