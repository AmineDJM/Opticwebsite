{
  "name": "@optic/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:create": "prisma migrate dev --create-only",
    "push": "prisma db push",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo node_modules dist src/generated *.tsbuildinfo"
  },
  "dependencies": {
    "@optic/core": "workspace:*",
    "@prisma/client": "^6.19.3",
    "zod": "^3.25.76",
    "@optic/catalog": "workspace:*",
    "@optic/config": "workspace:*",
    "@optic/commerce": "workspace:*"
  },
  "devDependencies": {
    "@optic/eslint-config": "workspace:*",
    "@optic/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@optic/theming": "workspace:*",
    "@optic/quiz-engine": "workspace:*",
    "@optic/auth": "workspace:*",
    "@optic/i18n": "workspace:*"
  }
}
