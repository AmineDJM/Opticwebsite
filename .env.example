# =============================================================================
# Optic Engine — environment configuration
#
# Copy to `.env` for local development, or set these in your host's environment
# for production. NEVER commit a filled-in `.env`. Secrets belong only here.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. The apps and Prisma both read this.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/opticengine?schema=public"

# --- Application secret ----------------------------------------------------
# Used to sign cookies / tokens. Generate with: openssl rand -base64 48
# MUST be changed in production. At least 32 characters.
APP_SECRET="change-me-with-openssl-rand-base64-48"

# --- Tenant selection ------------------------------------------------------
# Which website this deployment serves. In a single-tenant (exported) deployment
# this is pinned. In multi-tenant hosting, leave SITE_SLUG empty and resolution
# falls back to the request Host header against the Domain table.
SITE_SLUG="aura-optique"
NEXT_PUBLIC_SITE_SLUG="aura-optique"

# --- Public URLs (used for absolute links, canonical URLs, sitemaps) -------
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# --- Media storage ---------------------------------------------------------
# Driver: "local" (disk, default) or "s3" (any S3-compatible service).
STORAGE_DRIVER="local"

# Local driver:
STORAGE_LOCAL_DIR="./var/storage"
STORAGE_PUBLIC_URL="/media"

# S3 driver (only when STORAGE_DRIVER=s3). Works with AWS S3, MinIO, Cloudflare R2,
# Scaleway, OVH, etc. Set S3_ENDPOINT for non-AWS providers.
# S3_ENDPOINT="https://s3.example.com"
# S3_REGION="us-east-1"
# S3_BUCKET="optic-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# STORAGE_PUBLIC_URL="https://cdn.example.com"

# --- Website export --------------------------------------------------------
# Where the generator writes exported source-code archives.
EXPORT_OUTPUT_DIR="./exports"
